# Pflicht: API-Key von https://dash.voyageai.com
VOYAGE_API_KEY=
# Embedding-Modell (voyage-3-lite: 512 Dimensionen, schnell; Alternativen: voyage-3.5-lite, voyage-3.5)
VOYAGE_MODEL=voyage-3-lite

# Optional: Claude für Schritt 3 in Modul 4 (ohne Key wird nur der Prompt angezeigt)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# "hash" = Testmodus ohne Voyage-Key (keine echte Semantik!)
EMBEDDING_BACKEND=voyage
